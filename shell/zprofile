# The following lines were added by Docker Desktop to add commands to your PATH.
[ -d "$HOME/.docker/bin" ] && export PATH="$PATH:$HOME/.docker/bin"
# End of Docker Desktop section.

# Homebrew (Apple Silicon)
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

# Sublime Text CLI (`subl`)
SUBL_BIN="/Applications/Sublime Text.app/Contents/SharedSupport/bin"
[ -d "$SUBL_BIN" ] && export PATH="$SUBL_BIN:$PATH"
unset SUBL_BIN

# Claude Code and other user-installed binaries
export PATH="$HOME/.local/bin:$PATH"
