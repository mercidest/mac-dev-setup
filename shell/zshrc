# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time Oh My Zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
# ZSH_THEME="robbyrussell"

# disable oh-my-zsh themes for pure prompt
ZSH_THEME=""

# Set list of themes to pick from when loading at random
# Setting this variable when ZSH_THEME=random will cause zsh to load
# a theme from this variable instead of looking in $ZSH/themes/
# If set to an empty array, this variable will have no effect.
# ZSH_THEME_RANDOM_CANDIDATES=( "robbyrussell" "agnoster" )

# Uncomment the following line to use case-sensitive completion.
# CASE_SENSITIVE="true"

# Uncomment the following line to use hyphen-insensitive completion.
# Case-sensitive completion must be off. _ and - will be interchangeable.
# HYPHEN_INSENSITIVE="true"

# Uncomment one of the following lines to change the auto-update behavior
# zstyle ':omz:update' mode disabled  # disable automatic updates
# zstyle ':omz:update' mode auto      # update automatically without asking
# zstyle ':omz:update' mode reminder  # just remind me to update when it's time

# Uncomment the following line to change how often to auto-update (in days).
# zstyle ':omz:update' frequency 13

# Uncomment the following line if pasting URLs and other text is messed up.
# DISABLE_MAGIC_FUNCTIONS="true"

# Uncomment the following line to disable colors in ls.
# DISABLE_LS_COLORS="true"

# Uncomment the following line to disable auto-setting terminal title.
# DISABLE_AUTO_TITLE="true"

# Uncomment the following line to enable command auto-correction.
# ENABLE_CORRECTION="true"

# Uncomment the following line to display red dots whilst waiting for completion.
# You can also set it to another string to have that shown instead of the default red dots.
# e.g. COMPLETION_WAITING_DOTS="%F{yellow}waiting...%f"
# Caution: this setting can cause issues with multiline prompts in zsh < 5.7.1 (see #5765)
# COMPLETION_WAITING_DOTS="true"

# Uncomment the following line if you want to disable marking untracked files
# under VCS as dirty. This makes repository status check for large repositories
# much, much faster.
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# You can set one of the optional three formats:
# "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# or set a custom format using the strftime function format specifications,
# see 'man strftime' for details.
# HIST_STAMPS="mm/dd/yyyy"

# Would you like to use another custom folder than $ZSH/custom?
# ZSH_CUSTOM=/path/to/new-custom-folder

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(git)

source $ZSH/oh-my-zsh.sh

# User configuration
# Anaconda, only if installed on this machine.
[ -d "/opt/homebrew/anaconda3/bin" ] && export PATH="/opt/homebrew/anaconda3/bin:$PATH"

# --- Plugin manager: antidote (replaces unmaintained zplug) ---
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
if [ -r /opt/homebrew/opt/antidote/share/antidote/antidote.zsh ]; then
  source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh
  antidote load ~/.zsh_plugins.txt
fi

# --- Pure prompt ---
autoload -U promptinit; promptinit
prompt pure 2>/dev/null || PROMPT='%F{magenta}%~%f %# '
# Minimal touches: faint git arrows, no path color clash
zstyle :prompt:pure:path color cyan
zstyle :prompt:pure:git:branch color 242
zstyle :prompt:pure:prompt:success color magenta

# export MANPATH="/usr/local/man:$MANPATH"

# You may need to manually set your language environment
export LANG=en_US.UTF-8

# Preferred editor for local and remote sessions
# if [[ -n $SSH_CONNECTION ]]; then
#   export EDITOR='vim'
# else
#   export EDITOR='mvim'
# fi

# Compilation flags
# export ARCHFLAGS="-arch x86_64"

# --- Modern CLI integrations ---

# zoxide: smarter cd. `z foo` jumps to most-frecent dir matching foo, `zi` interactive.
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# atuin: searchable, syncable shell history. Ctrl-R to search.
command -v atuin >/dev/null && eval "$(atuin init zsh --disable-up-arrow)"

# fzf: fuzzy finder. Ctrl-T file, Alt-C dir, **<Tab> trigger.
command -v fzf >/dev/null && source <(fzf --zsh)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --cycle --info=inline'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

# bat: cat with syntax highlighting + colors for man pages
export BAT_THEME="ansi"
command -v bat >/dev/null && export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# --- Aliases ---
alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -l --git --group-directories-first --icons=auto'
alias la='eza -la --git --group-directories-first --icons=auto'
alias lt='eza --tree --level=2 --icons=auto'
alias cat='bat --paging=never'
alias grep='rg'
alias find='fd'
alias ..='cd ..'
alias ...='cd ../..'
alias zshconfig='${EDITOR} ~/.zshrc'
alias reload='exec zsh'

# --- Editor: Sublime Text if installed, otherwise vim ---
if command -v subl >/dev/null; then
  export EDITOR='subl -w'
  export VISUAL='subl -w'
  alias e='subl'           # e file.py  → open file
  alias e.='subl .'        # e.         → open current folder as a project
  alias st='subl'
  alias edit='subl'
  alias here='subl .'
else
  export EDITOR='vim'
  export VISUAL='vim'
fi

# Added by Claude Code installer
export PATH="$HOME/.local/bin:$PATH"

# --- tmux session helpers (per-session colors live in ~/.tmux.conf) ---
# ts [name]   attach to session <name> (default: main), creating it if needed
ts() { tmux new-session -A -s "${1:-main}"; }
# cs <name>   attach/create a session named <name> and run claude in it
cs() { tmux new-session -A -s "${1:?usage: cs <name>}" "exec ${SHELL} -lic claude"; }
# tl          list sessions with their assigned color + window count
tl() { tmux list-sessions -F '#{session_name}  ·  #{@scolor}  ·  #{session_windows}w#{?session_attached, (attached),}' 2>/dev/null || echo "no tmux server running"; }
alias cc='tmux new -A -s code'   # kept for muscle memory
# tk <name>   kill a session by name. Requires a name on purpose — a bare `tk`
# refuses, so a mistype can never wipe all your sessions.
tk() {
  if [[ -z "$1" ]]; then
    echo "usage: tk <session>   (name required — refusing to kill blindly)"; echo; tl; return 1
  fi
  tmux kill-session -t "$1" && echo "killed session: $1"
}

# On SSH login (and not already inside tmux), show the available sessions so
# you can pick one yourself with `ts <name>` / `cs <name>` — no auto-attach.
if [[ -n "$SSH_CONNECTION" && -z "$TMUX" ]]; then
  if tmux has-session 2>/dev/null; then
    print -P "%F{cyan}tmux sessions on this machine:%f"
    tmux list-sessions -F '  #{session_name}  ·  #{@scolor}  ·  #{session_windows}w#{?session_attached, (attached),}'
    print -P "  %F{242}attach:%f ts <name>    %F{242}new+claude:%f cs <name>    %F{242}list:%f tl"
  else
    print -P "%F{242}No tmux sessions yet. Start one with:%f cs <name>   (or ts <name>)"
  fi
fi

# --- iTerm2 session labeling (badge = big faded overlay; survives `claude`) ---
# badge <text>   →  paint a large translucent label on this window/tab
badge() { printf "\e]1337;SetBadgeFormat=%s\a" "$(printf '%s' "$*" | base64)"; }
# title <text>   →  set the tab/window title (note: `claude` may overwrite this)
title() { printf '\e]0;%s\a' "$*"; }
# clearbadge     →  remove the badge from this window
clearbadge() { printf "\e]1337;SetBadgeFormat=%s\a" ""; }
