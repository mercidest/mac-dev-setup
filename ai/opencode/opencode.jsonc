{
  "$schema": "https://opencode.ai/config.json",

  // OpenCode signs you into its own Zen models with `opencode auth login`.
  // The block below is only needed to ALSO reach OpenRouter's catalogue.
  // The key is read from the environment, never stored here — install.sh
  // creates ~/.ai-keys.env (chmod 600) and .zshrc exports it.
  "provider": {
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "anthropic/claude-sonnet-5": { "name": "Claude Sonnet 5" },
        "openai/gpt-5.6-terra": { "name": "GPT-5.6 Terra" },
        "deepseek/deepseek-v4-flash": { "name": "DeepSeek V4 Flash (cheap)" },
        "z-ai/glm-5.3-flash": { "name": "GLM 5.3 Flash (cheapest)" }
      }
    }
  }
}
