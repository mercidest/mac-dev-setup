# Copy to ~/.ai-keys.env, fill in, then: chmod 600 ~/.ai-keys.env
#
# ~/.ai-keys.env is git-ignored and lives OUTSIDE this repo on purpose.
# .zshrc sources it if it exists, so these land in your environment.
# Never commit a filled-in copy of this file anywhere.
#
# Claude Code, Codex CLI and OpenCode each sign in with your own account
# (`claude`, `codex login`, `opencode auth login`) and need nothing here.
# These keys are only for pay-per-token access through OpenRouter.

# https://openrouter.ai/settings/keys  — set a monthly spend limit while you're there
OPENROUTER_API_KEY=

# Optional: only if you use pi against OpenCode Zen instead of OpenRouter.
# OPENCODE_GO_API_KEY=
